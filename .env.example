DATASHIELD_DB_PASSWORD=replace-with-a-random-32-character-url-safe-password
DATABASE_URL=postgresql+psycopg://datashield:${DATASHIELD_DB_PASSWORD}@localhost:5434/datashield
DATASHIELD_JWT_SECRET=replace-with-a-random-32-character-or-longer-secret
DATASHIELD_AGENT_KEY=replace-with-an-independent-32-character-or-longer-secret
DATASHIELD_FRONTEND_ORIGIN=http://localhost:3000
# Optional category advice only; offsets supplied by caller. Restart after configuration.
DATASHIELD_SPAN_ADVISORY_ENABLED=false
DATASHIELD_SPAN_ARTIFACT=
DATASHIELD_SPAN_SELECTION_SHA256=
